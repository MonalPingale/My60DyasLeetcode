 public int minSteps(String s, String t) {
        int[] freq=new int[26];
        int cnt=0;
        for(char ch:s.toCharArray()){
            freq[ch-'a']++;
        }
        for(char ch:t.toCharArray()){
            freq[ch-'a']--;
        }
        for(int i=0;i<26;i++){
            while(freq[i]>0){
                cnt++;
                freq[i]--;
            }
        }
        return cnt;
    }

